# Copy to `.env` and adjust. docker-compose and run.sh both read this file.
# Every value here is a benchmark knob — change it, re-run, results change.

# --- Jellyfin pin (MUST match the Jellyfin version whose OpenAPI spec you vendored) ---
# Pin by digest for byte-reproducible comparisons. Get one with:
#   docker buildx imagetools inspect jellyfin/jellyfin:10.11.8 --format '{{.Manifest.Digest}}'
JELLYFIN_IMAGE=jellyfin/jellyfin:10.11.8
# JELLYFIN_IMAGE=jellyfin/jellyfin@sha256:...   # preferred: pin the digest

# --- Fair-comparison resource cap (identical for both servers) ---
BENCH_CPUS=4
BENCH_MEM=4g   # 2g OOM-kills ffmpeg on 4K HEVC transcode; identical for both either way

# --- Your real media library (recommended) ---
# Absolute host paths, mounted read-only and scanned. Movies makes the transcode test
# meaningful (real 4K); TV adds the Series/Season/Episode resolver + more items under load.
# Set either, both, or neither (fall back to synthetic padding below). Leave empty to skip.
REAL_MEDIA_DIR=/path/to/your/movies
REAL_TV_DIR=/path/to/your/tv

# --- Synthetic padding (OPTIONAL) ---
# A real 20-movie library is thin for stressing the query/DTO path under load. Set these
# >0 to pad with synthetic items (tiny clips) and get query-scaling numbers. 0 = real only.
# The transcode test still targets your largest real file regardless.
FIXTURE_MOVIES=0
FIXTURE_SERIES=0
FIXTURE_EPISODES_PER_SERIES=10

# --- Load profile (per endpoint, applied identically to both) ---
BENCH_VUS=50             # concurrent virtual users
BENCH_DURATION=30s       # measured load duration
BENCH_WARMUP_SECONDS=10  # untimed warm loop before measuring (lets .NET tiered JIT settle)
# Login-storm window (auth_login row — runs AFTER the mixed loop; see README "Write rows").
# Fewer VUs than BENCH_VUS on purpose: PBKDF2 is CPU-bound, 50-wide would measure CPU queueing.
BENCH_LOGIN_VUS=10
BENCH_LOGIN_DURATION=15s

# --- Deterministic admin creds (both servers seeded with these) ---
BENCH_ADMIN_USER=bench
BENCH_ADMIN_PASSWORD=benchpass123

# --- Transcode time-to-first-segment (worth it now that you have real 4K media) ---
RUN_TRANSCODE=1
TTFS_ITERATIONS=3        # cold play-starts measured per mode (copy + encode)
TTFS_BITRATE=8000000     # encode-mode MaxStreamingBitrate; far below the 4K source forces a real re-encode
