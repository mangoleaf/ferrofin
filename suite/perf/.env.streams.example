# Copy to `.env.streams` and point at your media. Read by streams-stage.sh ONLY.
#
# These six mounts reproduce the container paths the pinned snapshot's database
# references (/media/hot/*, /media/cold/*). Every one is mounted READ-ONLY by
# docker-compose.streams.yml, and the suite refuses to start if any comes up
# writable. No other stage ever mounts media.
STREAMS_HOT_MOVIES=/path/to/fast/movies
STREAMS_HOT_TV=/path/to/fast/tv
STREAMS_COLD_MOVIES=/path/to/nas/Movies
STREAMS_COLD_TV=/path/to/nas/TV
STREAMS_COLD_MUSIC=/path/to/nas/Music
STREAMS_COLD_EDU=/path/to/nas/Educational
