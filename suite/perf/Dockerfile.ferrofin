# Release build of the Ferrofin server + ffmpeg (scan probes with ffprobe; transcode needs ffmpeg).
# BuildKit cache mounts on target/ + the cargo registry make the parity fix-loop's repeated
# `up --build ferrofin` recompile only changed crates (~1 min) instead of the whole graph (~8 min).
# Requires DOCKER_BUILDKIT=1 (default in modern docker/compose). The binary is copied OUT of the
# cache in the same RUN, because cache mounts aren't part of the resulting image layer.
FROM rust:1.97.0-bookworm AS build
WORKDIR /src
COPY . .
# The build context excludes .git (.dockerignore), so the harness passes the
# host's `git describe` in as a build arg; build.rs (ferrofin-health) bakes it
# into the binary, and the harness verifies it back over GET /health/live
# before measuring — a stale cached binary carries a stale value and aborts
# the run instead of being silently benchmarked.
ARG GIT_DESCRIBE=
ENV FERROFIN_GIT_DESCRIBE=$GIT_DESCRIBE
RUN --mount=type=cache,target=/src/target,id=ferrofin-target \
    --mount=type=cache,target=/usr/local/cargo/registry,id=ferrofin-cargo-registry \
    cargo build --release -p ferrofin-server \
 && cp /src/target/release/ferrofin-server /usr/local/bin/ferrofin-server

# jellyfin-ffmpeg instead of Debian's ffmpeg: it carries the SIMD single-pass
# `tonemapx` HDR→SDR filter (several× faster than vanilla ffmpeg's zscale chain
# on a 4K HDR encode — the difference that put Jellyfin ahead on TTFS) plus a
# current ffmpeg/libx264. Symlinked onto $PATH so Ferrofin's discovery finds it.
FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg libchromaprint-tools \
 && curl -fsSL https://repo.jellyfin.org/jellyfin_team.gpg.key \
      | gpg --dearmor -o /usr/share/keyrings/jellyfin.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/jellyfin.gpg] https://repo.jellyfin.org/debian bookworm main" \
      > /etc/apt/sources.list.d/jellyfin.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends jellyfin-ffmpeg7 \
 && ln -s /usr/lib/jellyfin-ffmpeg/ffmpeg /usr/local/bin/ffmpeg \
 && ln -s /usr/lib/jellyfin-ffmpeg/ffprobe /usr/local/bin/ffprobe \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/ferrofin-server /usr/local/bin/ferrofin-server
EXPOSE 8096
ENTRYPOINT ["ferrofin-server"]
