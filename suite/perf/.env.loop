# Parity-leg env: seeded-snapshot data (BENCH_TESTDATA), no transcode.
# Used via: PARITY_ENV=.env.loop suite/parity/sweep.sh (the suite/run.sh parity leg).
JELLYFIN_IMAGE=jellyfin/jellyfin:10.11.8

BENCH_CPUS=4
BENCH_MEM=4g

# Seeded-snapshot data, no media mounted (see .env.example BENCH_TESTDATA).
BENCH_TESTDATA=1

# Testdata mode registers no synthetic video/music libraries (the snapshot has
# richer real items) — only the Live TV fixture is consumed:
FIXTURE_MOVIES=0
FIXTURE_SERIES=0
FIXTURE_ARTISTS=0
# Live TV: an M3U tuner (2 channels via the livetv-source sidecar) + XMLTV guide, so the
# live-stream / timer / recording ops run against a real tuner on both servers.
FIXTURE_LIVETV=1

BENCH_ADMIN_USER=bench
BENCH_ADMIN_PASSWORD=benchpass123

RUN_TRANSCODE=0
