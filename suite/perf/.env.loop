# Fast dataset for the parity fix-loop: synthetic only (no real media → no 2636-item scan),
# no transcode. Use with: PARITY_ENV=.env.loop ./parity.sh
# Milestone/name-cleaning fixes still need real media — run those with the default .env.
JELLYFIN_IMAGE=jellyfin/jellyfin:10.11.8

BENCH_CPUS=4
BENCH_MEM=4g

# No real media in the loop — structural fixes (Fields, folder filtering, DTO fields) don't need it.
REAL_MEDIA_DIR=
REAL_TV_DIR=

# Uses whatever synthetic fixtures already exist under fixtures/media (fast tiny files).
FIXTURE_MOVIES=500
FIXTURE_SERIES=8
FIXTURE_EPISODES_PER_SERIES=3
# Music library: artists x albums x tracks (tagged flac) — the by-name music endpoints and
# the /Audio/* stream family need a real audio item.
FIXTURE_ARTISTS=3
FIXTURE_ALBUMS_PER_ARTIST=1
FIXTURE_TRACKS_PER_ALBUM=3
# Live TV: an M3U tuner (2 channels via the livetv-source sidecar) + XMLTV guide, so the
# live-stream / timer / recording ops run against a real tuner on both servers.
FIXTURE_LIVETV=1
# The synthetic video counts above must match .env's: the tree is generated once and shared.

BENCH_ADMIN_USER=bench
BENCH_ADMIN_PASSWORD=benchpass123

RUN_TRANSCODE=0
