#!/usr/bin/env bash
# A docker for roundtrip.bats: it records every call in $FAKE_STATE/calls and plays each container with
# fake_server.py on a free loopback port. A Ferrofin container answers as Ferrofin, and logs the boot lines
# adoption_check_boot_log reads (the generation from the fixture's fake-generation file). An export
# container (`export-jellyfin --out`) copies what the Ferrofin one left to the output, its state included,
# and writes there the code migrations it left to run (fake-ran: the fixture's fake-left-to-run). A Jellyfin
# container answers from the export, and logs jellyfin-ok.log with a migration begun and finished for each
# line of fake-ran; on the 10.11.8 route with no fake-ran (a history left as it was), it logs
# jellyfin-start-failed.log and answers 503 to everything, as Jellyfin's setup server does after a failed
# start. An image whose name holds "dead" makes containers that exit at once. A tag only exists once
# `docker tag` made it. A container's id is not its name, and `rm` takes only an id (a name is "No such
# container"); each removal is logged by name in $FAKE_STATE/removed.
# Knobs: FAKE_RUN_DELAY (seconds a run takes), FAKE_EXIT_CODE (what a stopped container exited with),
# FAKE_JELLYFIN=loses (Jellyfin's copy has lost a favorite), =reshares (its playlist refresh shares a playlist
# again, as a stale playlist.xml would), =churns (its scan deletes an item), =hang (it answers 503 and never
# logs why), =exits (it stops with status 3 before it answers), =setup (its setup server answers first),
# =killed (it exits 137 when stopped), =errs (a log read after its first one has an ERR entry more) or
# =migrates-again (its second start logs a migration); FAKE_EXPORT=fails (the export exits 1), =hangs (it never
# ends), =history-kept (no fake-ran), =all-recorded (an empty fake-ran: every id recorded, so Jellyfin runs no
# migration), =stale-paths (the exported database still names the library folder where Ferrofin ran), or one
# fake_server.py's export breaks (=unreported, =extra-table, =drops-config). The export drops the tables of
# Ferrofin's and writes the loss report (fake_server.py export). A Jellyfin started a second time on one copy
# (the container <...>-jellyfin-again) logs no migration.
set -uo pipefail
state=${FAKE_STATE:?}
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
echo "$*" >> "$state/calls"
last=${*: -1}
alive() { [ -f "$state/$1.pid" ] && kill -0 "$(cat "$state/$1.pid")" 2>/dev/null; }
case "$1" in
  image)
    case "$*" in *missing*) exit 1;; esac
    case $last in ferrofin-roundtrip:*) [ -f "$state/tag-${last#*:}" ] || exit 1;; esac
    case "$*" in *'{{.Id}}'*) echo "sha256:fake-${last//[^a-z0-9]/-}";; *revision*) echo 0123abc;; esac
    exit 0;;
  tag) echo "$2" > "$state/tag-${3#*:}"; exit 0;;
  rmi) rm -f "$state/tag-${2#*:}"; exit 0;;
  run)
    args=("$@"); image=$last name='' cid='' config='' mounts=() out='' data=/config
    for ((i = 0; i < ${#args[@]}; i++)); do
      case ${args[i]} in
        --name) name=${args[i+1]};;
        --cidfile) cid=${args[i+1]};;
        -e) case ${args[i+1]} in FERROFIN_DATA_DIR=*) data=${args[i+1]#FERROFIN_DATA_DIR=};; esac;;
        -v) mounts+=("${args[i+1]}");;
        --out) out=${args[i+1]};;
      esac
    done
    # the data directory: the mount at FERROFIN_DATA_DIR, Jellyfin's /config by default
    for mount in "${mounts[@]}"; do case $mount in *:"$data") config=${mount%:"$data"};; esac; done
    if [ -e "$state/$name.name" ]; then echo "Conflict. The container name \"/$name\" is already in use" >&2; exit 125; fi
    case $image in ferrofin-roundtrip:*) image=$(cat "$state/tag-${image#*:}");; esac
    sleep "${FAKE_RUN_DELAY:-0}"
    id=cid-$(printf '%s' "$name" | sha1sum | cut -c1-12)
    echo "$name" > "$state/$name.name"; echo "$name" > "$state/$id.id"; echo "$id" > "$cid"
    if [ -n "$out" ]; then   # the export, in the foreground: the output is on a mount of its own
      for mount in "${mounts[@]}"; do
        case $out in "${mount#*:}"/*) out=${mount%%:*}${out#"${mount#*:}"};; esac
      done
      [ "${FAKE_EXPORT:-}" != fails ] || { printf 'Error: failed to export %s\n\nCaused by:\n    the database is damaged\n' "$data"; exit 1; }
      if [ "${FAKE_EXPORT:-}" = hangs ]; then   # a container that ignores TERM, as the export's process 1 does
        trap '' TERM; sleep 120 & echo $! > "$state/$name.pid"; wait; exit 137
      fi
      cp -a "$config" "$out" && python3 "$here/fake_server.py" export "$out" || exit 1
      case ${FAKE_EXPORT:-} in
        stale-paths) sqlite3 "$out/data/jellyfin.db" "INSERT INTO BaseItems (Id, Type, IsFolder, IsInMixedFolder, IsLocked,
          IsMovie, IsRepeat, IsSeries, IsVirtualItem, Path) VALUES ('EEEEEEEE-EEEE-EEEE-EEEE-EEEEEEEEEEEE',
          'MediaBrowser.Controller.Entities.Folder', 1, 0, 0, 0, 0, 0, 0, '$data/root/default/Movies')" || exit 1;;&
        history-kept) ;;
        all-recorded) : > "$out/fake-ran";;
        *) if [ -f "$config/fake-left-to-run" ]; then cp "$config/fake-left-to-run" "$out/fake-ran"; else : > "$out/fake-ran"; fi;;
      esac
      echo "Exported $data into ${args[*]: -1}"; exit 0
    fi
    case $image in *dead*) exit 0;; esac
    role=ferrofin behaviour=ok log=ok
    if [ "${name%-jellyfin}" != "$name" ] || [ "${name%-jellyfin-again}" != "$name" ]; then
      role=jellyfin
      case $config in */10.11.8/*) [ -f "$config/fake-ran" ] || behaviour=start-failed log=start-failed;; esac
      case ${FAKE_JELLYFIN:-} in
        loses) behaviour=loses;; reshares) behaviour=reshares;; churns) behaviour=churns;; hang) behaviour=start-failed;;
        setup) behaviour=setup;; exits) behaviour=exits; echo 3 > "$state/$name.exit";;
      esac
      [ "${name%-jellyfin-again}" = "$name" ] || [ "$log" != ok ] || log=again
    fi
    echo "$role $log $config" > "$state/$name.role"
    setsid python3 "$here/fake_server.py" serve "$state/$name.port" "$role" "$config" "$behaviour" >/dev/null 2>&1 &
    echo $! > "$state/$name.pid"
    for _ in $(seq 50); do [ -f "$state/$name.port" ] && exit 0; sleep 0.1; done
    echo "fake docker: the server for $name never listened" >&2; exit 1;;
  port) [ -f "$state/$2.port" ] || exit 1; echo "127.0.0.1:$(cat "$state/$2.port")"; exit 0;;
  inspect)
    case "$*" in
      *Running*) if alive "$last"; then echo true; else echo false; fi;;
      *ExitCode*) if [ -f "$state/$last.exit" ]; then cat "$state/$last.exit"; else echo "${FAKE_EXIT_CODE:-0}"; fi;;
    esac
    exit 0;;
  logs)
    read -r role log config < "$state/$last.role" 2>/dev/null || exit 0
    if [ "$role" = ferrofin ]; then
      printf '{"level":"INFO","fields":{"message":"adopted an existing Jellyfin database in place","generation":"%s"}}\n' \
        "$(cat "$config/fake-generation")"
      echo '{"level":"INFO","fields":{"message":"database migrations applied","migrations":49,"head":49}}'
    elif [ "$log" = ok ] || [ "$log" = again ]; then   # jellyfin-ok.log without its migrations, and those fake-ran lists
      head -n 1 "$here/jellyfin-ok.log"
      { [ "$log" = ok ] && cat "$config/fake-ran" 2>/dev/null; } | while read -r ran; do
        printf '[07:53:39] [INF] [10] InternalCodeMigration: %s\n' "Perform migration $ran" "Migration $ran was successfully applied"
      done
      [ "$log" != again ] || [ "${FAKE_JELLYFIN:-}" != migrates-again ] ||
        printf '[07:53:39] [INF] [10] InternalCodeMigration: Perform migration %s\n' 20260729120000_RestorePlaylistChildrenFromMetadata
      grep -v Migration "$here/jellyfin-ok.log" | tail -n +2
      reads=$(cat "$state/$last.reads" 2>/dev/null || echo 0); echo $((reads + 1)) > "$state/$last.reads"
      [ "$reads" = 0 ] || [ "${FAKE_JELLYFIN:-}" != errs ] ||
        echo '[07:53:40] [ERR] [10] Emby.Server.Implementations.Library.LibraryManager: Error validating the library'
    else
      cat "$here/jellyfin-$log.log"
    fi
    exit 0;;
  stop)
    ! alive "$last" || kill "$(cat "$state/$last.pid")"
    read -r role _ < "$state/$last.role" 2>/dev/null
    [ "${role:-}" != jellyfin ] || [ "${FAKE_JELLYFIN:-}" != killed ] || echo 137 > "$state/$last.exit"
    exit 0;;
  rm)
    [ -f "$state/$last.id" ] || { echo "Error response from daemon: No such container: $last" >&2; exit 1; }
    name=$(cat "$state/$last.id")
    ! alive "$name" || kill -KILL "$(cat "$state/$name.pid")"   # as docker rm -f does
    rm -f "$state/$name".* "$state/$last.id"; echo "$name" >> "$state/removed"; exit 0;;
esac
echo "unexpected docker $*" >&2
exit 99
