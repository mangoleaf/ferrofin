#!/bin/sh
# Ferrofin .deb postinst: create the service user and data directory, register
# the unit. The service is deliberately NOT enabled or started — the first boot
# needs the operator to configure a password or complete the web setup wizard
# (see INSTALL.md).
set -e

if [ "$1" = "configure" ]; then
    if ! getent passwd ferrofin >/dev/null; then
        adduser --system --group --quiet \
            --home /var/lib/ferrofin --no-create-home \
            --shell /usr/sbin/nologin \
            --gecos "Ferrofin media server" ferrofin
    fi
    # 0750: the database inside is nobody else's business.
    install -d -o ferrofin -g ferrofin -m 0750 /var/lib/ferrofin

    # The conffile may contain the bootstrap admin password. Apply this on
    # upgrades too, after the service group exists, without changing contents.
    # Preserve an explicit administrator override and a deliberately deleted file.
    if [ -f /etc/ferrofin/config.toml ] && ! dpkg-statoverride --list /etc/ferrofin/config.toml >/dev/null; then
        chown root:ferrofin /etc/ferrofin/config.toml
        chmod 0640 /etc/ferrofin/config.toml
    fi

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        # An upgrade restarts a running server so the new binary takes over.
        if [ -n "$2" ] && systemctl is-active --quiet ferrofin.service; then
            systemctl restart ferrofin.service >/dev/null 2>&1 || true
        fi
    fi
fi

exit 0
