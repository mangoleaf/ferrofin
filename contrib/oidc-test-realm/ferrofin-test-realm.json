{
  "realm": "ferrofin-test",
  "displayName": "Ferrofin test realm",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": false,
  "groups": [
    { "name": "ferrofin-admins", "path": "/ferrofin-admins" },
    { "name": "ferrofin-users", "path": "/ferrofin-users" }
  ],
  "users": [
    {
      "username": "oidc-admin",
      "enabled": true,
      "email": "oidc-admin@example.org",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "oidc-admin-password", "temporary": false }
      ],
      "groups": ["/ferrofin-admins"]
    },
    {
      "username": "oidc-member",
      "enabled": true,
      "email": "oidc-member@example.org",
      "emailVerified": true,
      "firstName": "Max",
      "lastName": "Member",
      "credentials": [
        { "type": "password", "value": "oidc-member-password", "temporary": false }
      ],
      "groups": ["/ferrofin-users"]
    },
    {
      "username": "oidc-guest",
      "enabled": true,
      "email": "oidc-guest@example.org",
      "emailVerified": true,
      "firstName": "Gus",
      "lastName": "Guest",
      "credentials": [
        { "type": "password", "value": "oidc-guest-password", "temporary": false }
      ],
      "groups": []
    }
  ],
  "clients": [
    {
      "clientId": "ferrofin",
      "name": "Ferrofin",
      "description": "A Ferrofin server under test",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "ferrofin-test-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://127.0.0.1:*",
        "http://localhost:*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
