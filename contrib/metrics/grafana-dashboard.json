{
  "__inputs": [],
  "__requires": [],
  "title": "Hermit — Overview",
  "uid": "hermit-overview",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "HTTP",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Request rate by controller",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (controller) (rate(http_requests_received_total[5m]))",
          "legendFormat": "{{controller}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request latency (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx error rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_received_total{code=~\"5..\"}[5m]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests in progress",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_requests_in_progress)",
          "legendFormat": "in progress"
        }
      ]
    },
    {
      "type": "row",
      "title": "Playback & sessions",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "type": "stat",
      "title": "Active sessions",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 18 },
      "targets": [{ "refId": "A", "expr": "hermit_sessions_active" }]
    },
    {
      "type": "stat",
      "title": "Active streams",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 18 },
      "targets": [{ "refId": "A", "expr": "hermit_playback_streams_active" }]
    },
    {
      "type": "stat",
      "title": "Active transcodes",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 18 },
      "targets": [{ "refId": "A", "expr": "hermit_transcode_jobs_active" }]
    },
    {
      "type": "stat",
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 18 },
      "targets": [{ "refId": "A", "expr": "hermit_uptime_seconds" }]
    },
    {
      "type": "timeseries",
      "title": "Playback streams by method",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 40 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [
        {
          "refId": "A",
          "expr": "hermit_playback_streams",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Library items by type",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [
        {
          "refId": "A",
          "expr": "hermit_library_items",
          "legendFormat": "{{type}}",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Process & database",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }
    },
    {
      "type": "timeseries",
      "title": "CPU usage (cores)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total[5m])",
          "legendFormat": "cpu cores"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory & file descriptors",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "targets": [
        {
          "refId": "A",
          "expr": "process_working_set_bytes",
          "legendFormat": "working set (bytes)"
        },
        {
          "refId": "B",
          "expr": "process_open_handles",
          "legendFormat": "open fds"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB pool — total vs idle",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "targets": [
        {
          "refId": "A",
          "expr": "hermit_db_pool_connections",
          "legendFormat": "{{pool}} total"
        },
        {
          "refId": "B",
          "expr": "hermit_db_pool_idle_connections",
          "legendFormat": "{{pool}} idle"
        }
      ]
    }
  ]
}
