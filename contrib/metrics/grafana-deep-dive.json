        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ferrofin_db_pool_connections - ferrofin_db_pool_idle_connections",
          "legendFormat": "{{pool}} in-use"
        }
