# Ferrofin media server — example systemd unit for a bare-metal install.
#
# Assumes the layout described in docs/INSTALL.md:
#   /usr/bin/ferrofin-server                the binary (the .deb puts it here; a tarball
#                                           install overrides ExecStart= with a drop-in)
#   /etc/ferrofin/config.toml               configuration (docs/CONFIG.md)
#   /var/lib/ferrofin                       data dir: jellyfin.db, cache/, log/, plugins/
#   /usr/lib/jellyfin-ffmpeg/               jellyfin-ffmpeg from the Jellyfin apt repository
#   /usr/share/jellyfin/web                 the jellyfin-web package's built client
#
# Install: cp contrib/systemd/ferrofin.service /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now ferrofin

[Unit]
Description=Ferrofin media server
Documentation=https://github.com/mangoleaf/ferrofin
Wants=network-online.target
After=network-online.target remote-fs.target
RequiresMountsFor=/var/lib/ferrofin

[Service]
Type=simple
User=ferrofin
Group=ferrofin
WorkingDirectory=/var/lib/ferrofin

# Fail fast, with a clear journal line, when a runtime dependency is missing.
ExecStartPre=/usr/bin/test -x /usr/lib/jellyfin-ffmpeg/ffmpeg
ExecStartPre=/usr/bin/test -x /usr/lib/jellyfin-ffmpeg/ffprobe
ExecStartPre=/usr/bin/test -r /usr/share/jellyfin/web/index.html

# systemd's PATH does not include /usr/lib/jellyfin-ffmpeg, so name the
# binaries explicitly rather than letting discovery find Debian's /usr/bin/ffmpeg.
# Everything here can live in config.toml instead; the environment wins.
Environment=FERROFIN_FFMPEG_PATH=/usr/lib/jellyfin-ffmpeg/ffmpeg
Environment=FERROFIN_FFPROBE_PATH=/usr/lib/jellyfin-ffmpeg/ffprobe
Environment=FERROFIN_WEB_DIR=/usr/share/jellyfin/web
ExecStart=/usr/bin/ferrofin-server --config /etc/ferrofin/config.toml

Restart=on-failure
RestartSec=5
# In-flight transcodes are killed on stop; the DB checkpoint is quick.
TimeoutStopSec=45

# VAAPI/QSV transcoding opens /dev/dri/renderD*, owned by the render group.
SupplementaryGroups=render

[Install]
WantedBy=multi-user.target
