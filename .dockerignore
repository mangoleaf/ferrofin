# Keep the docker build context small — the root Dockerfile builds from the repo root.
# (suite/ stays ignored defensively: retired v2 data dirs may linger on old checkouts.)
**/target/
**/.git
suite/
suite.*/
data/
**/.claude/
**/.worktrees/
.agents/
.codex/
.mcp.json
# The RustCodeGraph index (2.4GB) made "load build context" take longer than
# the compile; none of these feed the server build.
.rcg/
brain/
# benchmark test data and run output (gates/bench/ code itself is tiny)
gates/bench/testdata/
gates/bench/runs/
# The gates' old roots (moved under gates/ by gl-912): an older checkout's data may linger there.
bench/
adoption/
parity/
verify/
# Local databases and private adoption fixtures/reports (also in .gitignore).
**/*.db
**/*.db-shm
**/*.db-wal
**/jellyfin-10.*/
**/jellyfin-12.*/
**/media-mounts.sh
**/smoke-jellyfin-*.txt
gates/adoption/oracle/
gates/adoption/work/
gates/adoption/fixtures/
**/*.metadata.json
**/*.metadata-after-*.log
**/*.watch-history.json
**/*.watch-history-after-*.log
**/*.boot.log
**/*.boot2.log
**/*.server.log
**/*.smoke.txt
**/*.smoke2.txt
**/*.smoke-scan.txt
