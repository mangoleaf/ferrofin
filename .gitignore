/target
**/*.rs.bk
*.pdb
# per-crate PortJob agent scratch — only the coverage-gate allowlist is tracked
/.port/*/
# local media/data used for manual First-Light testing
/data
*.db
*.db-shm
*.db-wal
# insta review leftovers
*.snap.new
# agent worktrees (can grow to tens of GB of checkouts + target dirs)
**/.claude/worktrees/
# per-machine Claude settings
.claude/settings.local.json

brain/
.rcg/
__pycache__/

# local agent tooling — not part of the public project
.mcp.json
.claude/

# WASM plugin artifacts are build/CI outputs only — never committed
# (brain/plans/PLAN_PLUGIN_TIERS.md, artifact policy 2026-08-12)
*.wasm

# toolchain-island build dirs (root /target anchor does not reach them)
examples/*/target/

# Benchmark result backups — `runs.json` is the record; a `.bak` beside it
# is a scratch copy of the same runs and must never be committed.
suite/results/*.bak

# Parity response samples: 4MB+ of regenerable evidence, rewritten every parity
# run. Read it with suite/parity/show.py; it is an artifact, not source.
suite/parity/samples.json

# Pinned snapshot of the real Jellyfin instance used as suite test data
# (both servers boot copies of it; Ferrofin adopts, Jellyfin reads natively).
# ~10GB, and it contains real usernames and watch history — never committed,
# never published. Refreshed deliberately via suite/snapshot-testdata.sh;
# only the identifying MANIFEST.json is committed.
suite/test_data/*
!suite/test_data/MANIFEST.json
# Interrupted snapshot-testdata.sh runs can strand staging/old siblings
# (test_data.staging.<pid>, test_data.old.<pid>) full of the same private data.
suite/test_data.*
