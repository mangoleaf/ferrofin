/target
**/*.rs.bk
*.pdb
# per-crate PortJob agent scratch — only the coverage-gate allowlist is tracked
/.port/*/
# local media/data used for manual First-Light testing
/data
*.db
*.db-shm
*.db-wal
# insta review leftovers
*.snap.new
# agent worktrees (can grow to tens of GB of checkouts + target dirs)
**/.claude/worktrees/
# per-machine Claude settings
.claude/settings.local.json

brain/
.rcg/
__pycache__/

# local agent tooling — not part of the public project
.mcp.json
.claude/

# WASM plugin artifacts are build/CI outputs only — never committed
# (brain/plans/PLAN_PLUGIN_TIERS.md, artifact policy 2026-08-12)
*.wasm

# toolchain-island build dirs (root /target anchor does not reach them)
examples/*/target/

# The retired v2 benchmark suite lived at suite/ (removed 2026-09-02). Keep
# its data patterns ignored so a stale checkout or a v3 that reuses the path
# can never commit private snapshot data (real usernames + watch history).
suite/
suite.*/
