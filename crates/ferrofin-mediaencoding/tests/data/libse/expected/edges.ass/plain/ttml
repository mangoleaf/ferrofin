  </head>
  <body style="s0">
    <div>
      <p begin="1.0s" xml:id="p0" end="2.0s" style="Default" xmlns="http://www.w3.org/ns/ttml">multibyte colour style</p>
      <p begin="2.0s" xml:id="p1" end="3.0s" style="Tiny" xmlns="http://www.w3.org/ns/ttml">forty-five fraction digits</p>
      <p begin="3.0s" xml:id="p2" end="4.0s" style="Big" xmlns="http://www.w3.org/ns/ttml">twenty-nine significant digits</p>
    </div>
  </body>
